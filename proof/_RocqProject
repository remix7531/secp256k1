# IMPORTANT: keep the -Q / -arg directives below contiguous at the TOP, before
# any '#' comment.  coq-lsp stops collecting flags at the first comment, so a
# comment between directives makes the editor drop every later directive (make
# and clightgen read the whole file regardless).  One flat `secp256k1` namespace.
-Q . secp256k1
-arg -w -arg -deprecated-from-Coq
-arg -w -arg -deprecated-missing-stdlib

